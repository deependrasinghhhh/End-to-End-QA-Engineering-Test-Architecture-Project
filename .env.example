# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (QA E-COMMERCE PROJECT)
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real credentials, passwords, or production API keys to Git.
# - Copy this file to `.env` and fill in your actual environment details.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION UNDER TEST (AUT) CONFIGURATION
# ------------------------------------------------------------------------------
# Target environment for Playwright, API, and Performance tests
# Local Staging Mock: http://localhost:5001
# Local Docker AUT:   http://localhost:5000
# Remote QA / Demo:   https://demo.nopcommerce.com
BASE_URL=http://localhost:5001
API_BASE_URL=http://localhost:5001/api
ADMIN_BASE_URL=http://localhost:5001/admin

# Default QA Test Credentials (Non-production test accounts)
QA_CUSTOMER_EMAIL=customer@nopqa.local
QA_CUSTOMER_PASSWORD=TestPassword123!
QA_ADMIN_EMAIL=admin@nopqa.local
QA_ADMIN_PASSWORD=AdminPassword123!

# ------------------------------------------------------------------------------
# 2. TEST EXECUTION SETTINGS
# ------------------------------------------------------------------------------
HEADLESS=true
BROWSER=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
SLOW_MO=0
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
RETRIES=1
WORKERS=4

# ------------------------------------------------------------------------------
# 3. JIRA & XRAY TEST MANAGEMENT INTEGRATION
# ------------------------------------------------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=NOP
JIRA_EMAIL=qa-engineer@your-domain.com
JIRA_API_TOKEN=your_jira_api_token_here

# Xray Cloud REST API credentials
XRAY_CLIENT_ID=your_xray_client_id_here
XRAY_CLIENT_SECRET=your_xray_client_secret_here

# ------------------------------------------------------------------------------
# 4. CONFLUENCE WIKI INTEGRATION
# ------------------------------------------------------------------------------
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=NOPQA

# ------------------------------------------------------------------------------
# 5. DATABASE CONFIGURATION (PostgreSQL / DBeaver)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nopcommerce_qa
DB_USER=nop_qa
DB_PASSWORD=your_secure_db_password_here
DB_SSL=false

# ------------------------------------------------------------------------------
# 6. BROWSERSTACK (Optional Cloud Cross-Browser Testing)
# ------------------------------------------------------------------------------
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key
BROWSERSTACK_BUILD_NAME=nopcommerce-playwright-build
BROWSERSTACK_PROJECT_NAME=QA-Portfolio-Ecommerce

# ------------------------------------------------------------------------------
# 7. CI/CD INTEGRATION (Jenkins)
# ------------------------------------------------------------------------------
JENKINS_URL=http://localhost:8080
JENKINS_USER=qa_automation_service
JENKINS_API_TOKEN=your_jenkins_api_token_here
