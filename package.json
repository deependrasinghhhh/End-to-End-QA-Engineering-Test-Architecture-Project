{
  "name": "qa-ecommerce-portfolio-project",
  "version": "1.0.0",
  "description": "A Playwright + TypeScript QA automation portfolio project testing a deterministic, nopCommerce-inspired local staging simulator.",
  "author": "Senior QA Engineer / SDET & Test Architect",
  "license": "MIT",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all-browsers": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:regression": "playwright test --grep @regression --project=chromium",
    "test:critical": "playwright test --grep @critical --project=chromium",
    "test:customer": "playwright test --grep @customer --project=chromium",
    "test:admin": "playwright test --grep @admin --project=chromium",
    "test:api": "playwright test --grep @api --project=chromium",
    "test:a11y": "playwright test --grep @a11y --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:chrome": "playwright test --project=chrome",
    "test:edge": "playwright test --project=msedge",
    "test:firefox": "playwright test --project=firefox",
    "test:mobile": "playwright test --project=\"Mobile Chrome\"",
    "test:debug": "playwright test --project=chromium --debug",
    "test:ui": "playwright test --ui",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "report:html": "playwright show-report reports/playwright-html",
    "report:allure": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "aut:start": "node automation/staging-aut/server.js",
    "perf:k6": "k6 run performance/k6/smoke-perf.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/parser": "^8.71.1",
    "ajv": "^8.20.0",
    "allure-playwright": "^3.0.7",
    "eslint": "^10.12.0",
    "typescript": "^5.6.3"
  }
}
