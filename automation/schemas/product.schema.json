{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductItemResponse",
  "type": "object",
  "required": ["id", "name", "price", "sku"],
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "inStock": {
      "type": "boolean"
    }
  }
}
