{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthLoginResponse",
  "type": "object",
  "required": ["token", "user"],
  "properties": {
    "token": {
      "type": "string"
    },
    "user": {
      "type": "object",
      "required": ["id", "email"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
