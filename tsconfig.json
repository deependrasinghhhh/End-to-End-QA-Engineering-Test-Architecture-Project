{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["automation/pages/*"],
      "@components/*": ["automation/components/*"],
      "@fixtures/*": ["automation/fixtures/*"],
      "@api/*": ["automation/api/*"],
      "@utils/*": ["automation/utils/*"],
      "@test-data/*": ["automation/test-data/*"],
      "@schemas/*": ["automation/schemas/*"],
      "@config/*": ["automation/config/*"]
    }
  },
  "include": [
    "automation/**/*.ts",
    "accessibility/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
