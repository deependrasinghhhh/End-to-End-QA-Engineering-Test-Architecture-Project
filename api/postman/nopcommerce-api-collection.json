{
  "info": {
    "_postman_id": "7f8b91c0-3e2a-4a11-8910-bcde12345678",
    "name": "nopCommerce v4.70 Enterprise QA REST API Collection",
    "description": "Standardized Postman collection for manual and exploratory REST API validation of nopCommerce v4.70. Covers Authentication, Catalog, Shopping Cart, Checkout, and Administration endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /api/auth/login (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token is returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string');",
                  "    pm.environment.set(\"AUTH_TOKEN\", json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{QA_CUSTOMER_EMAIL}}\",\n  \"password\": \"{{QA_CUSTOMER_PASSWORD}}\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "POST /api/auth/login (Invalid Password - 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@nopqa.local\",\n  \"password\": \"WrongPassword999!\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "POST /api/auth/register (New User)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set(\"DYNAMIC_EMAIL\", \"postman_\" + Date.now() + \"@nopqa.local\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"User\",\n  \"email\": \"{{DYNAMIC_EMAIL}}\",\n  \"password\": \"TestPassword123!\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "GET /api/catalog/products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns array of products\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "    pm.expect(json.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/catalog/products",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "catalog", "products"]
            }
          }
        },
        {
          "name": "GET /api/catalog/products/:id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/catalog/products/1",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "catalog", "products", "1"]
            }
          }
        },
        {
          "name": "GET /api/catalog/search?q=computer",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/catalog/search?q=computer",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "catalog", "search"],
              "query": [{ "key": "q", "value": "computer" }]
            }
          }
        }
      ]
    },
    {
      "name": "Shopping Cart",
      "item": [
        {
